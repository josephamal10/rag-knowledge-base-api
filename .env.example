GEMINI_API_KEY=your-actual-key-here

# Upstash Vector (Hybrid index — no local vector server)
UPSTASH_VECTOR_REST_URL=https://your-index-xxxxx-us1-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your-upstash-token

# Must match the Upstash dense index dimension
EMBEDDING_DIMENSION=1536

PORT=3000

# NOTE: courseId is NOT configured here.
# Pass courseId on every API call (ingest / ask / reindex) — it maps 1:1 to an Upstash namespace.
# Example: "demo-club"
