# Backend URL. Leave empty in development (Vite proxies to http://localhost:3000).
# In production set it to the deployed API, e.g. https://your-api.onrender.com
VITE_API_URL=

# Show the "Add knowledge" panel (set to false for a public, read-only demo)
VITE_ENABLE_INGEST=true

# Course id selected by default
VITE_DEFAULT_COURSE_ID=demo-club
